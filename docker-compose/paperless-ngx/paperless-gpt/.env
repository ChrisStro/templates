# Load alongside ../.env using both --env-file options from the paperless-ngx directory.
# Fill in credentials locally; never commit real API keys or tokens.
PAPERLESS_API_TOKEN=
OPENAI_API_KEY=

# OpenAI or an OpenAI-compatible API endpoint (include /v1 if required).
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o
# OCR requires a vision-capable model and endpoint that accepts image input.
VISION_LLM_MODEL=gpt-4o
LLM_LANGUAGE=German

# The web UI is bound to 127.0.0.1 only.
PAPERLESS_GPT_PORT=8080
# Maximum pages for image-based OCR; 0 processes all pages.
OCR_LIMIT_PAGES=5
