BW_VERSION=1.6.17
PUBLIC_HOSTNAME=bw.127.0.0.1.nip.io
PROXY_NETWORK=
MYSQL_PASSWORD=changeme

# nginx DNS resolver - default 127.0.0.11 (Docker embedded DNS).
# Under podman the embedded DNS doesn't exist, use the network gateway IP instead:
# DNS_RESOLVERS=10.20.30.1
#DNS_RESOLVERS=

# Docker socket for the autoconf socket-proxy; e.g. rootless podman:
# DOCKER_SOCKET=/run/user/1000/podman/podman.sock
#DOCKER_SOCKET=

# Optional: strong token to secure the internal BunkerWeb API
# (keep empty if you rely on API_WHITELIST_IP only)
#API_TOKEN=
