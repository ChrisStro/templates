PUBLIC_HOSTNAME=litellm.127.0.0.1.nip.io
PROXY_NETWORK=
LITELLM_IMAGE_TAG=v1.106.4

# Credentials - never commit real values. Generate them with:
#   openssl rand -hex 32
# LITELLM_MASTER_KEY is the admin credential for the API and the Admin UI password (user "admin").
# It is documented to start with "sk-"; the proxy only refuses to start with no, an empty, or a
# publicly known key, so any long random value works - the prefix is the convention.
# LITELLM_SALT_KEY encrypts the provider credentials stored in Postgres: generate it once, back it
# up together with the database, and never change it - a new salt makes stored keys unreadable.
LITELLM_MASTER_KEY=
LITELLM_SALT_KEY=
POSTGRES_PASSWORD=

# Set to False to let the proxy fetch the latest model price map from GitHub on every start.
LITELLM_LOCAL_MODEL_COST_MAP=True

# Provider keys for models that reference them as os.environ/<NAME>
#OPENAI_API_KEY=
#ANTHROPIC_API_KEY=
#GEMINI_API_KEY=
#AZURE_API_KEY=
#AZURE_API_BASE=
#OLLAMA_API_BASE=http://host.containers.internal:11434
