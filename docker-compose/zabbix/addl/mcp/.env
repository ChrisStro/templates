# Load alongside ../.env using both --env-file options from docker-compose/zabbix.
# This file lives in addl/mcp and only contains MCP-specific values.
# Keep this file local to your environment and never commit live secrets.

# Public Zabbix API endpoint ending in api_jsonrpc.php.
# Default uses the in-stack zabbix-web service on the internal network.
ZBX_FRONTEND_URL=http://zabbix-web:8080/api_jsonrpc.php

# Restrict MCP client source IPs/networks when the service is reachable remotely.
ZBX_ALLOWEDIP=127.0.0.1,::1

# Container listen settings.
ZBX_LISTENIP=0.0.0.0
ZBX_LISTENPORT=8443

# Host loopback port for local MCP access.
ZBX_MCP_PORT=8443

# Public hostname used by the Traefik router label.
ZBX_MCP_PUBLIC_HOSTNAME=mcp.zabbix.x.x.x.x.nip.io

# Optional runtime tuning.
ZBX_DEBUGLEVEL=3
ZBX_TIMEOUT=10
ZBX_IGNOREURLCERTERRORS=false
ZBX_MAX_RESPONSE_SIZE=64K
ZBX_TOOL_PREFIX=
