HINDSIGHT_API_PUBLIC_HOSTNAME=hindsight-api.127.0.0.1.nip.io
HINDSIGHT_UI_PUBLIC_HOSTNAME=hindsight-ui.127.0.0.1.nip.io
PROXY_NETWORK=

# Required LLM API key used by Hindsight for extraction and answer generation.
# Never commit a real key.
HINDSIGHT_API_LLM_API_KEY=

# Optional runtime overrides
# HINDSIGHT_IMAGE_TAG=latest
# HINDSIGHT_API_LLM_PROVIDER=openai
# HINDSIGHT_API_WORKER_ID=hindsight-prod
# UI_TRAEFIK_ENTRYPOINTS=websecure
