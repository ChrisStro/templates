# --- Deployment method ---
# Default (without Assistant/Sandbox):
COMPOSE_FILE=compose.yaml
# Optional (with Assistant/Sandbox):
# COMPOSE_FILE=compose.yaml:compose.assistant.yaml

# --- Reverse proxy template vars (keep empty in template) ---
PUBLIC_HOSTNAME=
PROXY_NETWORK=

# --- Optional Assistant/Sandbox vars ---
# Keep these placeholders empty in template and set values per environment when needed.
N8N_SANDBOX_VERSION=
N8N_SANDBOX_SERVICE_URL=
N8N_SANDBOX_SERVICE_API_KEY=
SANDBOX_API_KEYS=
SANDBOX_RUNNER_REGISTRATION_TOKEN=
SANDBOX_RUNNER_API_KEYS=
SEARXNG_SECRET=
N8N_INSTANCE_AI_SEARXNG_URL=
